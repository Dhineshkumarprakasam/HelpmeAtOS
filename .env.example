# Rename this file to .env and fill in your values
GEMINI_API_KEY=your_gemini_api_key_here

# Chroma DB Cloud Configuration
CHROMA_CLOUD_API_KEY=your_chroma_api_key_here
CHROMA_CLOUD_TENANT=your_tenant_id_here
CHROMA_CLOUD_DATABASE=your_database_name_here
CHROMA_COLLECTION_NAME=your_collection_name_here

# Rate Limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60